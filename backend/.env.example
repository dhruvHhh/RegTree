# Copy this file to `backend/.env` and fill in your own keys.
# The real .env is gitignored — never commit actual keys.
#
#   Groq:       https://console.groq.com
#   OpenRouter: https://openrouter.ai

GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# Set to false to extract PDF text with a plain loop instead of PySpark (the Docker image does).
# USE_SPARK=true
